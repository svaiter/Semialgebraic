import TauCeti.Geometry.RealAlgebraic.CAD.Existence
import TauCeti.Geometry.RealAlgebraic.Semialgebraic.Image

/-!
# Interface theorem A1: projections of real semialgebraic sets (Tarski–Seidenberg)

This file provides, in TauCeti's vocabulary, the statement that HardnessBilevel assumes through the class
`Bilevel.HasSemialgebraicProjections` (assumption A1).

* `Semialgebraic.isSemialgebraic_iff_mem_generateSetAlgebra` : over `ℝ`, `TauCeti.IsSemialgebraic s` is, by
  definition, membership in the set algebra generated by polynomial zero sets and positivity sets. The right-hand
  side is written with no reference to TauCeti; it is the body of `Bilevel.IsSemialgebraic`, so the bridge between
  the two predicates is `Iff.rfl`.
* `Semialgebraic.Interface.image_comp_inl` : the interface theorem. Its statement is the field `image_comp_inl` of
  `Bilevel.HasSemialgebraicProjections` with `Bilevel.IsSemialgebraic` replaced by `TauCeti.IsSemialgebraic`
  (same binders `{α β : Type} [Fintype α] [Finite β]`, same conclusion).

The proof is TauCeti's `TauCeti.IsSemialgebraic.image_comp_inl`, instantiated with TauCeti's instance
`TauCeti.HasSemialgebraicProjections ℝ` (cylindrical algebraic decomposition, `CAD/Existence.lean`).
The `[Fintype α]` binder is not needed by the proof; it is kept so that the statement matches the class field.
-/

open MeasureTheory

namespace Semialgebraic

/-- Over `ℝ`, `TauCeti.IsSemialgebraic` unfolds definitionally to membership in the set algebra generated by
polynomial zero sets and positivity sets. -/
theorem isSemialgebraic_iff_mem_generateSetAlgebra {ι : Type*} (s : Set (ι → ℝ)) :
    TauCeti.IsSemialgebraic s ↔
      s ∈ generateSetAlgebra
        (Set.range (fun p : MvPolynomial ι ℝ => {x | MvPolynomial.eval x p = 0}) ∪
         Set.range (fun p : MvPolynomial ι ℝ => {x | 0 < MvPolynomial.eval x p})) :=
  Iff.rfl

namespace Interface

/-- **Interface theorem A1** (Tarski–Seidenberg, projection form): forgetting finitely many coordinates
preserves semialgebraicity of subsets of real affine space. -/
theorem image_comp_inl {α β : Type} [Fintype α] [Finite β] {S : Set (α ⊕ β → ℝ)} :
    TauCeti.IsSemialgebraic S →
      TauCeti.IsSemialgebraic ((fun z : α ⊕ β → ℝ => z ∘ Sum.inl) '' S) :=
  fun hS => TauCeti.IsSemialgebraic.image_comp_inl hS

end Interface

end Semialgebraic
